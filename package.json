{
  "name": "smoovdeck",
  "private": true,
  "version": "0.1.0",
  "packageManager": "nub@0.7.5",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/ui"
  ],
  "scripts": {
    "dev": "nub run --filter @smoovdeck/ui dev",
    "build:ui": "nub run --filter @smoovdeck/ui build",
    "test": "nub run --filter @smoovdeck/ui test",
    "typecheck": "nub run --filter @smoovdeck/ui typecheck",
    "lint": "oxlint --disable-nested-config",
    "check:effect-lens": "nub exec effect-lens check --project . --workspace packages/ui --mode unified"
  },
  "devDependencies": {
    "@boozedog/effect-lens": "0.1.0",
    "@foldkit/oxlint-plugin": "0.6.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "oxlint": "1.78.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  }
}
