# Nub: isolated store in node_modules (see foldstryx).
node-linker=isolated
enableGlobalVirtualStore=false
# Fresh Foldkit / Effect rc pins (min-release-age gate).
minimum-release-age-exclude=["foldkit@0.147.0","@foldkit/ui@0.147.0","@foldkit/vite-plugin@0.14.0","@foldkit/devtools@0.147.0","effect@4.0.0-rc.109","@effect/vitest@4.0.0-rc.109","@effect/platform-browser@4.0.0-rc.109","@foldstryx/foldkit@0.3.2","@foldstryx/styles@0.2.2","@foldstryx/tokens@0.1.2"]
